# JWT Configuration
# Use a strong secret in production. This example should contain a placeholder only.
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=86400000

# SendGrid Configuration
# Replace with your SendGrid API key and from-address in your local .env only
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=your_from_email@example.com

# Database Configuration (for dev and production)
DATABASE_PASSWORD=your_database_password

# Production Database (override in production)
DATABASE_URL=jdbc:mysql://localhost:3306/autoserve
DATABASE_USERNAME=root

# admin email : admin@example.com
# admin password : AdminPass123!
