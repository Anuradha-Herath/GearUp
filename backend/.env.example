# JWT Configuration
JWT_SECRET=devSecretKeyForJwtTokenGenerationThatShouldBeAtLeast256BitsLongForDevelopment
JWT_EXPIRATION=86400000

# SendGrid Configuration
SENDGRID_API_KEY=your-actual-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@autoserve.com

# Database Configuration (for dev and production)
DATABASE_PASSWORD=your-secure-database-password

# Production Database (override in production)
DATABASE_URL=jdbc:mysql://localhost:3306/gearup
DATABASE_USERNAME=root

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here
