# JWT Configuration
JWT_SECRET=your-secure-jwt-secret-key-at-least-256-bits-long-change-this-in-production
JWT_EXPIRATION=86400000

# SendGrid Configuration (Get your API key from https://app.sendgrid.com/settings/api_keys)
SENDGRID_API_KEY=SG.XXXXXXXXXXXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SENDGRID_FROM_EMAIL=noreply@gearup.com

# Database Configuration
DATABASE_PASSWORD=your-secure-database-password

# Spring Profile (dev, prod, test)
SPRING_PROFILES_ACTIVE=prod
