# Production Environment Configuration for Frontend

# API Configuration
# NOTE: This URL is baked into the build at BUILD TIME
# For Docker deployments, use the backend service name
VITE_API_BASE_URL=http://backend:8080/api

# For external deployments, use your actual domain
# VITE_API_BASE_URL=https://api.gearup.com/api

# Build Configuration
VITE_APP_NAME=GearUp
VITE_APP_VERSION=1.0.0

# Feature Flags (optional)
# VITE_ENABLE_CHATBOT=true
# VITE_ENABLE_ANALYTICS=true

# Note: All VITE_* variables are embedded in the build
# They are NOT available at runtime in the Docker container
# If you need runtime configuration, consider using a config.js file
# that gets loaded dynamically
